CC=gcc
LD=ld
ASM=nasm

CFLAGS=-ffreestanding -m32 -c -fno-stack-protector -fno-builtin -fno-pic -fno-pie -I.
LDFLAGS=-m elf_i386 -T linker/bsdlinker.ld -nostdlib

KERNEL_OBJ = kernel/kernel.o kernel/game.o kernel/ata.o kernel/ahci.o kernel/store.o kernel/idt.o kernel/elf.o kernel/atomic.o kernel/libc.o kernel/libc2.o kernel/exec.o kernel/setjmp_asm.o kernel/linux.o kernel/nic.o kernel/net.o kernel/tls.o arch/x86/linux_asm.o

# Doom is a separately installable ELF32 package, never a kernel built-in.
BIN_SRC = $(filter-out bin/doom.c,$(wildcard bin/*.c))
BIN_OUT = $(BIN_SRC:bin/%.c=home/bin/%.o)
TCC_HDRS = $(wildcard tools/tcc/std-include/*.h tools/tcc/std-include/sys/*.h)
TCC_BUILD_SCRIPT ?= build-tcc.sh
TCC_SRC = tools/tcc/build-tcc.sh tools/tcc/build-tcc-arm64.sh tools/tcc/tanja-libc.c tools/tcc/tanja-libc.h \
          tools/tcc/tanja-tcc-main.c tools/tcc/install-headers.sh $(TCC_HDRS) \
          $(wildcard tools/tcc/tinycc/*.c) $(wildcard tools/tcc/tinycc/*.h) \
          $(wildcard tools/tcc/tanja-libc-include/*.h)
HOME_OBJ = home_tar.o


all: arch/x86/boot/tanja-base ports/doom/build/doom
	@echo
	@echo "[INFO] TanjaOS image ready at arch/x86/boot/tanja-base"
	@echo

BUILD_TS := $(shell date +%s)

include/build_id.h: $(wildcard kernel/*.c) $(wildcard fs/*.c) $(BIN_SRC) $(wildcard include/*.h) home.tar
	@echo "[GEN] include/build_id.h (build $(BUILD_TS))"
	@echo "/* Auto-generated by the build - do not edit or commit. */" > $@
	@echo "#define TANJA_BUILD_ID_LO $(BUILD_TS)u" >> $@
	@echo "#define TANJA_BUILD_ID_HI 0u" >> $@

home/bin:
	mkdir -p home/bin

BIN_CFLAGS = -m32 -ffreestanding -fno-stack-protector -fno-builtin \
             -fno-pic -fno-pie -fno-common \
             -fno-asynchronous-unwind-tables \
             -Wno-builtin-declaration-mismatch -I include -I .

HDRS = $(filter-out include/build_id.h,$(wildcard include/*.h))
home/bin/%.o: bin/%.c $(HDRS) | home/bin
	@echo "[CC] bin/$*.c (ELF32)"
	$(CC) $(BIN_CFLAGS) -c $< -o $@

tools/tcc/tcc.o: $(TCC_SRC)
	@if [ -f tools/tcc/tinycc/tcc.c ]; then \
		echo "[TCC] building TinyCC (freestanding i386 object)"; \
		(cd tools/tcc && ./$(TCC_BUILD_SCRIPT)); \
		(cd tools/tcc && ./install-headers.sh); \
	else \
		echo "[TCC] tinycc source tree not present; using bundled tools/tcc/tcc.o"; \
		test -f tools/tcc/tcc.o; \
	fi

home.tar: Makefile $(shell find home -type f -o -type d 2>/dev/null | grep -v '^home/bin/') $(BIN_OUT) $(wildcard home/bin/*)
	@rm -f home/bin/doom.o home/bin/tcc.o
	@echo "[TAR] Packing home/ (binaries as /bin, headers as /usr/include)"
	rm -rf .home-stage
	tar --format=ustar -cf $@ -C home .

home_tar.o: home.tar
	@echo "[OBJ] Embedding home/"
	$(LD) -r -b binary -m elf_i386 -o $@ $<

kernel/%.o: kernel/%.c $(HDRS)
	@echo "[CC] kernel/$(notdir $<)"
	$(CC) $(CFLAGS) -o $@ $<


BR_GCC_INC := $(shell $(CC) $(filter -m32,$(CFLAGS)) -print-file-name=include)
BR_CFLAGS = $(filter -m32,$(CFLAGS)) -c -O2 -ffreestanding -fno-builtin -fno-pic -fno-pie \
            -fno-stack-protector -nostdinc -isystem tools/bearssl/shim -isystem $(BR_GCC_INC) \
            -Itools/bearssl/src -Itools/bearssl/inc \
            -DBR_USE_UNIX_TIME=0 -DBR_USE_WIN32_TIME=0 -DBR_USE_URANDOM=0 -DBR_USE_GETENTROPY=0 -DBR_USE_WIN32_RAND=0
include tools/bearssl/sources.mk
BR_OBJ = $(BR_SRC:tools/bearssl/src/%.c=tools/bearssl/build/%.o)
AR ?= ar

tools/bearssl/build/%.o: tools/bearssl/src/%.c
	@mkdir -p $(dir $@)
	@echo "[CC] bearssl/$*.c"
	@$(CC) $(BR_CFLAGS) -o $@ $<

tools/bearssl/libbearssl.a: $(BR_OBJ)
	@echo "[AR] libbearssl.a"
	@rm -f $@
	@$(AR) rcs $@ $^

kernel/tls.o: kernel/tls.c kernel/tls_anchors.h include/build_id.h tools/bearssl/libbearssl.a
	@echo "[CC] kernel/tls.c"
	$(CC) $(CFLAGS) -Itools/bearssl/inc -o $@ kernel/tls.c

kernel/store.o: kernel/store.c include/build_id.h
	@echo "[CC] kernel/store.c"
	$(CC) $(CFLAGS) -o kernel/store.o kernel/store.c


arch/x86/idt_asm.o: arch/x86/idt_asm.asm
	@echo "[ASM] idt_asm.asm"
	$(ASM) -f elf32 arch/x86/idt_asm.asm -o arch/x86/idt_asm.o


fs/fs.o: fs/fs.c
	@echo "[CC] fs/fs.c"
	$(CC) $(CFLAGS) -o fs/fs.o fs/fs.c


arch/x86/boot/boot.o: arch/x86/boot/boot.asm | arch/x86/boot
	@echo "[ASM] boot.asm"
	$(ASM) -f elf32 arch/x86/boot/boot.asm -o arch/x86/boot/boot.o


kernel/setjmp_asm.o: kernel/setjmp_asm.asm
	@echo "[ASM] setjmp_asm.asm"
	$(ASM) -f elf32 kernel/setjmp_asm.asm -o kernel/setjmp_asm.o

arch/x86/linux_asm.o: arch/x86/linux_asm.asm
	@echo "[ASM] linux_asm.asm"
	$(ASM) -f elf32 arch/x86/linux_asm.asm -o arch/x86/linux_asm.o


# Build Doom as a standalone relocatable ELF package for pkg_doom.
# It is deliberately not linked into tanja-base or copied into /bin.
ports/doom/build/doom: $(wildcard ports/doom/*.c ports/doom/Makefile ports/doom/engine/* ports/doom/include/* ports/doom/include/sys/* ports/doom/wad/*)
	@$(MAKE) --no-print-directory -C ports/doom CC="$(CC)" LD="$(LD)" ARCH_FLAGS="$(filter -m32,$(CFLAGS))"


arch/x86/boot/tanja-base: arch/x86/boot/boot.o arch/x86/idt_asm.o $(KERNEL_OBJ) fs/fs.o $(HOME_OBJ) tools/bearssl/libbearssl.a | arch/x86/boot
	@echo "[LD] Linking..."
	$(LD) $(LDFLAGS) -o arch/x86/boot/tanja-base \
		arch/x86/boot/boot.o \
		arch/x86/idt_asm.o \
		$(KERNEL_OBJ) \
		fs/fs.o \
		$(HOME_OBJ) \
		tools/bearssl/libbearssl.a \
		$(shell $(CC) -m32 -print-libgcc-file-name)



clean:
	rm -rf kernel/*.o fs/*.o tools/tcc/build
	rm -rf arch/x86/boot/*.o arch/x86/boot/tanja-base
	$(MAKE) -C ports/doom clean
	rm -rf arch/x86/*.o home.tar home_tar.o *.o
	rm -f home/bin/*.o
	rm -rf .home-stage include/build_id.h tools/bearssl/build tools/bearssl/libbearssl.a

.PHONY: all clean
